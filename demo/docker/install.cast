[15.775638, "o", "     PROFIL                   DESCRIPTION                                        UTILISÉ FICHIER\r\n"]
[15.8371, "o", "  ⬜ docker                   A profile that deploy docker in an LXD container   -       profiles/containerization/docker.profile.yaml\r\n"]
[15.844426, "o", "  ⬜ docker-unprivileged      A profile that deploy docker in an unprivileged L… -       profiles/containerization/docker-unprivileged.profile.yaml\r\n"]
[15.850853, "o", "  ⬜ docker-volume-data       A profile that add a volume for docker data        -       profiles/containerization/docker-volume-data.profile.yaml\r\n"]
[15.856893, "o", "  ⬜ docker-volume-manifests  A profile that mount a manifests directory from t… -       profiles/containerization/docker-volume-manifests.profile.yaml\r\n"]
[15.957692, "o", "  ⬜ proxy-docker             Expose private docker sock via tcp on the host     -       profiles/proxy/proxy-docker.profile.yaml\r\n"]
[15.963834, "o", "  ⬜ proxy-docker-unix        Expose the Docker socket as a Unix socket          -       profiles/proxy/proxy-docker-unix.profile.yaml\r\n"]
