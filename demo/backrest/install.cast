[6.324748, "o", "\u001b[38;5;246m  17\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Description=Backrest (restic web UI)\u001b[0m\r\n"]
[6.324752, "o", "\u001b[38;5;246m  18\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          After=network-online.target\u001b[0m\r\n"]
[6.324779, "o", "\u001b[38;5;246m  19\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Wants=network-online.target\u001b[0m\r\n\u001b[38;5;246m  20\u001b[0m \u001b[38;5;246m│\u001b[0m \r\n\u001b[38;5;246m  21\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          [Service]\u001b[0m\r\n\u001b[38;5;246m  22\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Type=simple\u001b[0m\r\n"]
[6.324793, "o", "\u001b[38;5;246m  23\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          # root : lecture de tous les fichiers des volumes montés en lecture seule\u001b[0m\r\n\u001b[38;5;246m  24\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          User=root\u001b[0m\r\n"]
[6.324797, "o", "\u001b[38;5;246m  25\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          ExecStart=/usr/local/bin/backrest\u001b[0m\r\n"]
[6.324808, "o", "\u001b[38;5;246m  26\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Environment=\"BACKREST_PORT=0.0.0.0:9898\"\u001b[0m\r\n"]
[6.324812, "o", "\u001b[38;5;246m  27\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Environment=\"BACKREST_CONFIG=/etc/backrest/config.json\"\u001b[0m\r\n"]
[6.32483, "o", "\u001b[38;5;246m  28\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Environment=\"BACKREST_DATA=/var/lib/backrest\"\u001b[0m\r\n\u001b[38;5;246m  29\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          Restart=on-failure\u001b[0m\r\n\u001b[38;5;246m  30\u001b[0m \u001b[38;5;246m│\u001b[0m \r\n"]
[6.324839, "o", "\u001b[38;5;246m  31\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          [Install]\u001b[0m\r\n"]
[6.324866, "o", "\u001b[38;5;246m  32\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m          WantedBy=multi-user.target\u001b[0m\r\n\u001b[38;5;246m  33\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m    runcmd:\u001b[0m\r\n\u001b[38;5;246m  34\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      - mkdir -p /etc/backrest /var/lib/backrest\u001b[0m\r\n"]
[6.324898, "o", "\u001b[38;5;246m  35\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      - curl -fsSL https://github.com/garethgeorge/backrest/releases/latest/download/backrest_Linux_x86_64.tar.gz | tar xz -C /usr/local/bin backrest\u001b[0m\r\n\u001b[38;5;246m  36\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      - systemctl daemon-reload\u001b[0m\r\n\u001b[38;5;246m  37\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      - systemctl enable --now backrest\u001b[0m\r\n\u001b[38;5;246m  38\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      # restic en CLI (restauration, tests) : celui que backrest télécharge et\u001b[0m\r\n"]
[6.324924, "o", "\u001b[38;5;246m  39\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      # maintient à la version requise (celui d'Ubuntu est trop ancien pour backrest)\u001b[0m\r\n\u001b[38;5;246m  40\u001b[0m \u001b[38;5;246m│\u001b[0m \u001b[38;5;186m      - ln -sf /var/lib/backrest/restic /usr/local/bin/restic\u001b[0m\r\n\u001b[38;5;246m─────┴──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
