#!/usr/bin/env bash
#MISE description="Affiche le diff entre un profil du dépôt et le profil installé dans LXD"
#MISE quiet=true
#USAGE arg "[profile]..." help="Nom de profil ou fichier du dépôt (défaut : tous les profils installés)"
#USAGE flag "--exit-code" help="Code retour 1 en cas de différence (comme git diff --exit-code)"
#USAGE complete "profile" run="mise run --quiet _names"
set -uo pipefail
source "$MISE_PROJECT_ROOT/.mise/lib.sh"

eval "args=(${usage_profile:-})"
all=false
if [ "${#args[@]}" -eq 0 ]; then
  all=true
  mapfile -t args < <(repo_index | cut -f2)
fi

status=0
for arg in "${args[@]}"; do
  file=$(resolve_file "$arg") || { status=2; continue; }
  name=$(profile_name "$file")
  if ! is_installed "$name"; then
    $all || warn "$name : non installé dans LXD"
    continue
  fi
  keys=$(unknown_keys "$file")
  [ -z "$keys" ] || warn "$file : clé(s) ignorée(s) par LXD : $keys"
  if show_diff "$file" "$name"; then
    $all || info "$name : identique"
  else
    status=1
  fi
done
[ "$status" -eq 1 ] && [ "${usage_exit_code:-false}" != "true" ] && status=0
exit "$status"
